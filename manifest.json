{
  "manifest_version": 3,
  "name": "blender-blender",
  "version": "2.0",
  "description": "Blend two websites: opens the good student tab and puts the bad student tab on top. Adjust percentage, swap, dark mode, emergency toggle.",
  "permissions": [
    "storage",
    "tabs",
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "emergency": {
      "suggested_key": {
        "default": "Ctrl+X",
        "mac": "Command+X"
      },
      "description": "Emergency toggle: show 100% good student tab, press again to restore"
    },
    "toggleBar": {
      "suggested_key": {
        "default": "Ctrl+K",
        "mac": "Command+K"
      },
      "description": "Show/hide the blender control bar"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "overlay-frame.html",
        "overlay-frame.js",
        "keys-config.js",
        "keys.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
